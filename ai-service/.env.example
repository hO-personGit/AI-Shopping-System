# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=db_aps

# AI service
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
FAISS_INDEX_PATH=data/product_faiss
RETRIEVAL_TOP_K=5

# LLM provider: mock | openai | dashscope | zhipu | openai_compatible
# mock 不需要 key，适合先跑通功能；接入真实模型时改 provider 和 key。
LLM_PROVIDER=mock
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=45

# 检索策略：hybrid（推荐，向量+关键词多路召回）/ vector / keyword
RETRIEVAL_MODE=hybrid
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4

# 语义精排（Rerank）：none | lexical（默认，无外部依赖） | api（接 Rerank 服务）
# api 模式需配置 RERANK_BASE_URL（如通义/OpenAI 兼容 rerank 端点）、RERANK_API_KEY
RERANK_MODE=lexical
RERANK_MODEL=bge-reranker-v2-m3
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_TOP_N=5

# 问答结果缓存（秒）
CACHE_TTL_SECONDS=600
CACHE_MAX_SIZE=256

# 多轮对话记忆
MEMORY_MAX_TURNS=6
MEMORY_TTL_SECONDS=1800
MEMORY_MAX_SESSIONS=1000
