# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=db_aps

# AI service
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
FAISS_INDEX_DIR=./data/faiss_products
RETRIEVAL_TOP_K=6

# LLM provider: mock | openai | dashscope | zhipu | openai_compatible
# mock 不需要 key，适合先跑通功能；接入真实模型时改 provider 和 key。
LLM_PROVIDER=mock
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=45
